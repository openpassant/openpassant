{
  "name": "@openpassant/server",
  "version": "0.1.0",
  "description": "Passant issuing API and persistence: battery models, batch minting, append-only passport versions with per-section hashing, and the anchor queue.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@openpassant/core": "workspace:*",
    "@openpassant/schema": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  }
}
