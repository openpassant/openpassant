# Passant server configuration. Copy to .env and fill in; secrets never
# live in the repository (hard rule 5).

# Origin the passport identifiers live under (operator's own subdomain).
# No path, no trailing slash. Example: https://id.yourbrand.com
BASE_URL=

# PostgreSQL connection string, e.g. postgres://user:pass@localhost:5432/passant
DATABASE_URL=

# Bearer key protecting the issuing API. SECRET.
ISSUER_API_KEY=

# Anchor batching (defaults shown; see HLD section 6).
# ANCHOR_BATCH_WINDOW_MS=600000
# ANCHOR_BATCH_MAX=1000

# HTTP port of the issuing API (default 3000).
# PORT=3000

# VeChain testnet anchoring (M3). All five are required together, or none.
# Testnet ONLY (hard rule 4): startup refuses any other network and also
# verifies the node's genesis id before anchoring anything.
# VECHAIN_NODE_URL=https://testnet.vechain.org
# VECHAIN_NETWORK=testnet
# VECHAIN_CONTRACT_ADDRESS=   # printed by: pnpm --filter @openpassant/adapter-vechain deploy:testnet
# VECHAIN_PUBLIC_NODE_URL=    # node URL embedded in public pages for the browser verifier (default: VECHAIN_NODE_URL)
# OPERATOR_PRIVATE_KEY=       # SECRET. Signs anchor transactions; holds no funds.
# SPONSOR_PRIVATE_KEY=        # SECRET. VIP-191 gas payer; fund with faucet VTHO.

# Docker Compose only: password for the bundled PostgreSQL (default: passant).
# POSTGRES_PASSWORD=
