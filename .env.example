# Passant server configuration. Copy to .env and fill in; secrets never
# live in the repository (hard rule 5).

# Origin the passport identifiers live under (operator's own subdomain).
# No path, no trailing slash. Example: https://id.yourbrand.com
BASE_URL=

# PostgreSQL connection string, e.g. postgres://user:pass@localhost:5432/passant
DATABASE_URL=

# Bearer key protecting the issuing API. SECRET.
ISSUER_API_KEY=

# Anchor batching (defaults shown; see HLD section 6).
# ANCHOR_BATCH_WINDOW_MS=600000
# ANCHOR_BATCH_MAX=1000

# HTTP port of the issuing API (default 3000).
# PORT=3000
